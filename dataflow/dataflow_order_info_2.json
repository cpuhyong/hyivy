{
	"name": "dataflow_order_info_2",
	"properties": {
		"description": "第二种方法用UNION做\n不是UNION ALL，结果只是并集",
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "tds_order_info",
						"type": "DatasetReference"
					},
					"name": "sourcetds"
				},
				{
					"dataset": {
						"referenceName": "ods_order_info",
						"type": "DatasetReference"
					},
					"name": "sourceods"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "test2",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "union1"
				},
				{
					"name": "window1"
				},
				{
					"name": "filter1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          id as long,",
				"          consignee as string,",
				"          consignee_tel as string,",
				"          total_amount as decimal(38,18),",
				"          order_status as string,",
				"          user_id as long,",
				"          payment_way as string,",
				"          delivery_address as string,",
				"          order_comment as string,",
				"          out_trade_no as string,",
				"          trade_body as string,",
				"          create_time as timestamp,",
				"          operate_time as timestamp,",
				"          expire_time as timestamp,",
				"          process_status as string,",
				"          tracking_no as string,",
				"          parent_order_id as long,",
				"          img_url as string,",
				"          province_id as integer,",
				"          activity_reduce_amount as decimal(38,18),",
				"          coupon_reduce_amount as decimal(38,18),",
				"          original_total_amount as decimal(38,18),",
				"          feight_fee as decimal(38,18),",
				"          feight_fee_reduce as decimal(38,18),",
				"          refundable_time as timestamp",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false,",
				"     format: 'parquet') ~> sourcetds",
				"source(output(",
				"          id as long,",
				"          consignee as string,",
				"          consignee_tel as string,",
				"          total_amount as decimal(38,18),",
				"          order_status as string,",
				"          user_id as long,",
				"          payment_way as string,",
				"          delivery_address as string,",
				"          order_comment as string,",
				"          out_trade_no as string,",
				"          trade_body as string,",
				"          create_time as timestamp,",
				"          operate_time as timestamp,",
				"          expire_time as timestamp,",
				"          process_status as string,",
				"          tracking_no as string,",
				"          parent_order_id as long,",
				"          img_url as string,",
				"          province_id as integer,",
				"          activity_reduce_amount as decimal(38,18),",
				"          coupon_reduce_amount as decimal(38,18),",
				"          original_total_amount as decimal(38,18),",
				"          feight_fee as decimal(38,18),",
				"          feight_fee_reduce as decimal(38,18),",
				"          refundable_time as timestamp",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false,",
				"     format: 'parquet') ~> sourceods",
				"sourcetds, sourcetds union(byName: true)~> union1",
				"union1 window(over(id),",
				"     desc(operate_time, true),",
				"     rn = rowNumber()) ~> window1",
				"window1 filter(rn==1) ~> filter1",
				"filter1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     format: 'parquet',",
				"     truncate: true,",
				"     umask: 0022,",
				"     preCommands: [],",
				"     postCommands: [],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> sink1"
			]
		}
	}
}