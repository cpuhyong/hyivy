{
	"name": "dataflow_tds_ods",
	"properties": {
		"description": "第三种方法用做exist，union最优，\n采用做模版",
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "tds",
						"type": "DatasetReference"
					},
					"name": "sourcetds"
				},
				{
					"dataset": {
						"referenceName": "ods",
						"type": "DatasetReference"
					},
					"name": "sourceods"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "ods",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "exists1"
				},
				{
					"name": "union1"
				}
			],
			"scriptLines": [
				"parameters{",
				"     p_start_time as string ('2026-01-24 06:20:05')",
				"}",
				"source(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false,",
				"     purgeFiles: true,",
				"     format: 'parquet') ~> sourcetds",
				"source(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false,",
				"     purgeFiles: true,",
				"     modifiedBefore: (toTimestamp($p_start_time,'yyyy-MM-dd HH:mm:ss')),",
				"     format: 'parquet') ~> sourceods",
				"sourceods, sourcetds exists(sourceods@id == sourcetds@id,",
				"     negate:true,",
				"     broadcast: 'auto')~> exists1",
				"exists1, sourcetds union(byName: true)~> union1",
				"union1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     format: 'parquet',",
				"     umask: 0022,",
				"     preCommands: [],",
				"     postCommands: [],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     saveOrder: 1) ~> sink1"
			]
		}
	}
}