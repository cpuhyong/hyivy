{
	"name": "dataflow_order_info",
	"properties": {
		"description": "第一种方法用JOIN+SPLIT+UNION做",
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "tds_order_info",
						"type": "DatasetReference"
					},
					"name": "sourcetds"
				},
				{
					"dataset": {
						"referenceName": "ods_order_info",
						"type": "DatasetReference"
					},
					"name": "sourceods"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "test1",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "join1"
				},
				{
					"name": "select1"
				},
				{
					"name": "derivedColumn1"
				},
				{
					"name": "split1"
				},
				{
					"name": "selectold"
				},
				{
					"name": "selectnew"
				},
				{
					"name": "union1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          id as long,",
				"          consignee as string,",
				"          consignee_tel as string,",
				"          total_amount as decimal(38,18),",
				"          order_status as string,",
				"          user_id as long,",
				"          payment_way as string,",
				"          delivery_address as string,",
				"          order_comment as string,",
				"          out_trade_no as string,",
				"          trade_body as string,",
				"          create_time as timestamp,",
				"          operate_time as timestamp,",
				"          expire_time as timestamp,",
				"          process_status as string,",
				"          tracking_no as string,",
				"          parent_order_id as long,",
				"          img_url as string,",
				"          province_id as integer,",
				"          activity_reduce_amount as decimal(38,18),",
				"          coupon_reduce_amount as decimal(38,18),",
				"          original_total_amount as decimal(38,18),",
				"          feight_fee as decimal(38,18),",
				"          feight_fee_reduce as decimal(38,18),",
				"          refundable_time as timestamp",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     limit: 100,",
				"     ignoreNoFilesFound: false,",
				"     format: 'parquet') ~> sourcetds",
				"source(output(",
				"          id as long,",
				"          consignee as string,",
				"          consignee_tel as string,",
				"          total_amount as decimal(38,18),",
				"          order_status as string,",
				"          user_id as long,",
				"          payment_way as string,",
				"          delivery_address as string,",
				"          order_comment as string,",
				"          out_trade_no as string,",
				"          trade_body as string,",
				"          create_time as timestamp,",
				"          operate_time as timestamp,",
				"          expire_time as timestamp,",
				"          process_status as string,",
				"          tracking_no as string,",
				"          parent_order_id as long,",
				"          img_url as string,",
				"          province_id as integer,",
				"          activity_reduce_amount as decimal(38,18),",
				"          coupon_reduce_amount as decimal(38,18),",
				"          original_total_amount as decimal(38,18),",
				"          feight_fee as decimal(38,18),",
				"          feight_fee_reduce as decimal(38,18),",
				"          refundable_time as timestamp",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false,",
				"     format: 'parquet') ~> sourceods",
				"sourcetds, sourceods join(sourcetds@id == sourceods@id,",
				"     joinType:'outer',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> join1",
				"join1 select(mapColumn(",
				"          new_id = sourcetds@id,",
				"          new_consignee = sourcetds@consignee,",
				"          new_consignee_tel = sourcetds@consignee_tel,",
				"          new_total_amount = sourcetds@total_amount,",
				"          new_order_status = sourcetds@order_status,",
				"          new_user_id = sourcetds@user_id,",
				"          new_payment_way = sourcetds@payment_way,",
				"          new_delivery_address = sourcetds@delivery_address,",
				"          new_order_comment = sourcetds@order_comment,",
				"          new_out_trade_no = sourcetds@out_trade_no,",
				"          new_trade_body = sourcetds@trade_body,",
				"          new_create_time = sourcetds@create_time,",
				"          new_operate_time = sourcetds@operate_time,",
				"          new_expire_time = sourcetds@expire_time,",
				"          new_process_status = sourcetds@process_status,",
				"          new_tracking_no = sourcetds@tracking_no,",
				"          new_parent_order_id = sourcetds@parent_order_id,",
				"          new_img_url = sourcetds@img_url,",
				"          new_province_id = sourcetds@province_id,",
				"          new_activity_reduce_amount = sourcetds@activity_reduce_amount,",
				"          new_coupon_reduce_amount = sourcetds@coupon_reduce_amount,",
				"          new_original_total_amount = sourcetds@original_total_amount,",
				"          new_feight_fee = sourcetds@feight_fee,",
				"          new_feight_fee_reduce = sourcetds@feight_fee_reduce,",
				"          new_refundable_time = sourcetds@refundable_time,",
				"          old_id = sourceods@id,",
				"          old_consignee = sourceods@consignee,",
				"          old_consignee_tel = sourceods@consignee_tel,",
				"          old_total_amount = sourceods@total_amount,",
				"          old_order_status = sourceods@order_status,",
				"          old_user_id = sourceods@user_id,",
				"          old_payment_way = sourceods@payment_way,",
				"          old_delivery_address = sourceods@delivery_address,",
				"          old_order_comment = sourceods@order_comment,",
				"          old_out_trade_no = sourceods@out_trade_no,",
				"          old_trade_body = sourceods@trade_body,",
				"          old_create_time = sourceods@create_time,",
				"          old_operate_time = sourceods@operate_time,",
				"          old_expire_time = sourceods@expire_time,",
				"          old_process_status = sourceods@process_status,",
				"          old_tracking_no = sourceods@tracking_no,",
				"          old_parent_order_id = sourceods@parent_order_id,",
				"          old_img_url = sourceods@img_url,",
				"          old_province_id = sourceods@province_id,",
				"          old_activity_reduce_amount = sourceods@activity_reduce_amount,",
				"          old_coupon_reduce_amount = sourceods@coupon_reduce_amount,",
				"          old_original_total_amount = sourceods@original_total_amount,",
				"          old_feight_fee = sourceods@feight_fee,",
				"          old_feight_fee_reduce = sourceods@feight_fee_reduce,",
				"          old_refundable_time = sourceods@refundable_time",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select1",
				"select1 derive(Record_Action = iif(isNull(new_id), 'keep_old', 'use_new')) ~> derivedColumn1",
				"derivedColumn1 split(Record_Action == 'keep_old',",
				"     Record_Action == 'use_new',",
				"     disjoint: false) ~> split1@(split1, split2)",
				"split1@split1 select(mapColumn(",
				"          id = old_id,",
				"          consignee = old_consignee,",
				"          consignee_tel = old_consignee_tel,",
				"          total_amount = old_total_amount,",
				"          order_status = old_order_status,",
				"          user_id = old_user_id,",
				"          payment_way = old_payment_way,",
				"          delivery_address = old_delivery_address,",
				"          order_comment = old_order_comment,",
				"          out_trade_no = old_out_trade_no,",
				"          trade_body = old_trade_body,",
				"          create_time = old_create_time,",
				"          operate_time = old_operate_time,",
				"          expire_time = old_expire_time,",
				"          process_status = old_process_status,",
				"          tracking_no = old_tracking_no,",
				"          parent_order_id = old_parent_order_id,",
				"          img_url = old_img_url,",
				"          province_id = old_province_id,",
				"          activity_reduce_amount = old_activity_reduce_amount,",
				"          coupon_reduce_amount = old_coupon_reduce_amount,",
				"          original_total_amount = old_original_total_amount,",
				"          feight_fee = old_feight_fee,",
				"          feight_fee_reduce = old_feight_fee_reduce,",
				"          refundable_time = old_refundable_time,",
				"          Record_Action",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> selectold",
				"split1@split2 select(mapColumn(",
				"          id = new_id,",
				"          consignee = new_consignee,",
				"          consignee_tel = new_consignee_tel,",
				"          total_amount = new_total_amount,",
				"          order_status = new_order_status,",
				"          user_id = new_user_id,",
				"          payment_way = new_payment_way,",
				"          delivery_address = new_delivery_address,",
				"          order_comment = new_order_comment,",
				"          out_trade_no = new_out_trade_no,",
				"          trade_body = new_trade_body,",
				"          create_time = new_create_time,",
				"          operate_time = new_operate_time,",
				"          expire_time = new_expire_time,",
				"          process_status = new_process_status,",
				"          tracking_no = new_tracking_no,",
				"          parent_order_id = new_parent_order_id,",
				"          img_url = new_img_url,",
				"          province_id = new_province_id,",
				"          activity_reduce_amount = new_activity_reduce_amount,",
				"          coupon_reduce_amount = new_coupon_reduce_amount,",
				"          original_total_amount = new_original_total_amount,",
				"          feight_fee = new_feight_fee,",
				"          feight_fee_reduce = new_feight_fee_reduce,",
				"          refundable_time = new_refundable_time,",
				"          Record_Action",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> selectnew",
				"selectold, selectnew union(byName: true)~> union1",
				"union1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     format: 'parquet',",
				"     umask: 0022,",
				"     preCommands: [],",
				"     postCommands: [],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> sink1"
			]
		}
	}
}