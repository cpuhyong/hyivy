{
	"name": "pl_sale_order",
	"properties": {
		"activities": [
			{
				"name": "sc_get_time",
				"type": "Script",
				"dependsOn": [
					{
						"activity": "Set v_table_name",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"linkedServiceName": {
					"referenceName": "AzureSqlDatabase1",
					"type": "LinkedServiceReference"
				},
				"typeProperties": {
					"scripts": [
						{
							"parameters": [
								{
									"name": "p_tss_name",
									"type": "String",
									"value": {
										"value": "@variables('v_table_name')",
										"type": "Expression"
									},
									"direction": "Input"
								}
							],
							"type": "Query",
							"text": "select begin_time,end_time,tss_inc_col from current_info_ods where tss_name = @p_tss_name"
						}
					],
					"scriptBlockExecutionTimeout": "02:00:00"
				}
			},
			{
				"name": "Set v_begin_time",
				"type": "SetVariable",
				"dependsOn": [
					{
						"activity": "sc_get_time",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "v_begin_time",
					"value": {
						"value": "@activity('sc_get_time').output.resultSets[0].rows[0].begin_time",
						"type": "Expression"
					}
				}
			},
			{
				"name": "Set v_end_time",
				"type": "SetVariable",
				"dependsOn": [
					{
						"activity": "sc_get_time",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "v_end_time",
					"value": {
						"value": "@activity('sc_get_time').output.resultSets[0].rows[0].end_time",
						"type": "Expression"
					}
				}
			},
			{
				"name": "Set v_table_name",
				"type": "SetVariable",
				"dependsOn": [],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "v_table_name",
					"value": {
						"value": "@substring(pipeline().Pipeline,3,sub(length(pipeline().Pipeline),3))",
						"type": "Expression"
					}
				}
			},
			{
				"name": "Set v_inc_col",
				"type": "SetVariable",
				"dependsOn": [
					{
						"activity": "sc_get_time",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "v_inc_col",
					"value": {
						"value": "@activity('sc_get_time').output.resultSets[0].rows[0].tss_inc_col",
						"type": "Expression"
					}
				}
			},
			{
				"name": "sp_write_begin_log",
				"type": "SqlServerStoredProcedure",
				"dependsOn": [
					{
						"activity": "Set v_inc_col",
						"dependencyConditions": [
							"Succeeded"
						]
					},
					{
						"activity": "Set v_end_time",
						"dependencyConditions": [
							"Succeeded"
						]
					},
					{
						"activity": "Set v_begin_time",
						"dependencyConditions": [
							"Succeeded"
						]
					},
					{
						"activity": "Set v_runstart_time",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"storedProcedureName": "[dbo].[common_write_log]",
					"storedProcedureParameters": {
						"p_execute_sec": {
							"value": "0",
							"type": "Decimal"
						},
						"p_indents": {
							"value": "1",
							"type": "Int32"
						},
						"p_log_grade": {
							"value": "一般",
							"type": "String"
						},
						"p_log_message": {
							"value": {
								"value": "concat('开始抽取',@variables('v_table_name'))",
								"type": "Expression"
							},
							"type": "String"
						}
					}
				},
				"linkedServiceName": {
					"referenceName": "AzureSqlDatabase1",
					"type": "LinkedServiceReference"
				}
			},
			{
				"name": "Set v_runstart_time",
				"type": "SetVariable",
				"dependsOn": [
					{
						"activity": "sc_get_time",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "v_runstart_time",
					"value": {
						"value": "@utcNow()",
						"type": "Expression"
					}
				}
			}
		],
		"variables": {
			"v_begin_time": {
				"type": "String"
			},
			"v_end_time": {
				"type": "String"
			},
			"v_table_name": {
				"type": "String"
			},
			"v_inc_col": {
				"type": "String"
			},
			"v_runstart_time": {
