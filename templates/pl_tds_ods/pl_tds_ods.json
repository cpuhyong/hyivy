{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "数据工厂名称"
		},
		"AzureSqlDatabase1": {
			"type": "string"
		},
		"AzureDataLakeStorage1": {
			"type": "string"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "[concat(parameters('factoryName'), '/pl_ods_order_info')]",
			"type": "Microsoft.DataFactory/factories/pipelines",
			"apiVersion": "2018-06-01",
			"properties": {
				"activities": [
					{
						"name": "sc_get_var",
						"type": "Script",
						"dependsOn": [
							{
								"activity": "Set v_table_name",
								"dependencyConditions": [
									"Succeeded"
								]
							}
						],
						"policy": {
							"timeout": "0.12:00:00",
							"retry": 0,
							"retryIntervalInSeconds": 30,
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"linkedServiceName": {
							"referenceName": "[parameters('AzureSqlDatabase1')]",
							"type": "LinkedServiceReference"
						},
						"typeProperties": {
							"scripts": [
								{
									"parameters": [
										{
											"name": "p_source_name",
											"type": "String",
											"value": {
												"value": "@variables('v_table_name')",
												"type": "Expression"
											},
											"direction": "Input"
										}
									],
									"type": "Query",
									"text": "select begin_time,end_time,tss_inc_col from current_info_ods where source_table_name = @p_source_name"
								}
							],
							"scriptBlockExecutionTimeout": "02:00:00"
						}
					},
					{
						"name": "Set v_begin_time",
						"type": "SetVariable",
						"dependsOn": [
							{
								"activity": "sc_get_var",
								"dependencyConditions": [
									"Succeeded"
								]
							}
						],
						"policy": {
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"variableName": "v_begin_time",
							"value": {
								"value": "@activity('sc_get_var').output.resultSets[0].rows[0].begin_time",
								"type": "Expression"
							}
						}
					},
					{
						"name": "Set v_end_time",
						"type": "SetVariable",
						"dependsOn": [
							{
								"activity": "sc_get_var",
								"dependencyConditions": [
									"Succeeded"
								]
							}
						],
						"policy": {
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"variableName": "v_end_time",
							"value": {
								"value": "@activity('sc_get_var').output.resultSets[0].rows[0].end_time",
								"type": "Expression"
							}
						}
					},
					{
						"name": "Set v_table_name",
						"type": "SetVariable",
						"dependsOn": [],
						"policy": {
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"variableName": "v_table_name",
							"value": {
								"value": "@substring(pipeline().Pipeline,7,sub(length(pipeline().Pipeline),7))",
								"type": "Expression"
							}
						}
					},
					{
						"name": "Set v_inc_col",
						"type": "SetVariable",
						"dependsOn": [
							{
								"activity": "sc_get_var",
								"dependencyConditions": [
									"Succeeded"
								]
							}
						],
						"policy": {
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"variableName": "v_inc_col",
							"value": {
								"value": "@activity('sc_get_var').output.resultSets[0].rows[0].tss_inc_col",
								"type": "Expression"
							}
						}
					},
					{
						"name": "sp_write_begin_log",
						"type": "SqlServerStoredProcedure",
						"dependsOn": [
							{
								"activity": "Set v_inc_col",
								"dependencyConditions": [
									"Succeeded"
								]
							},
							{
								"activity": "Set v_end_time",
								"dependencyConditions": [
									"Succeeded"
								]
							},
							{
								"activity": "Set v_begin_time",
								"dependencyConditions": [
									"Succeeded"
								]
							},
							{
								"activity": "Set v_runstart_time",
								"dependencyConditions": [
									"Succeeded"
								]
							}
						],
						"policy": {
							"timeout": "0.12:00:00",
							"retry": 0,
							"retryIntervalInSeconds": 30,
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"storedProcedureName": "[[dbo].[common_write_log]",
							"storedProcedureParameters": {
								"p_execute_sec": {
									"value": "0",
									"type": "Decimal"
								},
								"p_indents": {
									"value": "1",
									"type": "Int32"
								},
								"p_log_grade": {
									"value": "一般",
									"type": "String"
								},
								"p_log_message": {
									"value": {
										"value": "@concat('开始抽取 tds_',variables('v_table_name'),'到ODS')",
										"type": "Expression"
									},
									"type": "String"
								},
								"p_task_proc_name": {
									"value": {
										"value": "@concat(pipeline().Pipeline,':',pipeline().RunId)",
										"type": "Expression"
									},
									"type": "String"
								}
							}
						},
						"linkedServiceName": {
							"referenceName": "[parameters('AzureSqlDatabase1')]",
							"type": "LinkedServiceReference"
						}
					},
					{
						"name": "Set v_runstart_time",
						"type": "SetVariable",
						"dependsOn": [
							{
								"activity": "sc_get_var",
								"dependencyConditions": [
									"Succeeded"
								]
							}
						],
						"policy": {
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"variableName": "v_runstart_time",
							"value": {
								"value": "@formatDateTime(utcNow(), 'yyyy-MM-dd HH:mm:ss')",
								"type": "Expression"
							}
						}
					},
					{
						"name": "sp_write_success_log",
						"type": "SqlServerStoredProcedure",
						"dependsOn": [
							{
								"activity": "sc_update_flag",
								"dependencyConditions": [
									"Succeeded"
								]
							}
						],
						"policy": {
							"timeout": "0.12:00:00",
							"retry": 0,
							"retryIntervalInSeconds": 30,
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"storedProcedureName": "[[dbo].[common_write_log]",
							"storedProcedureParameters": {
								"p_execute_sec": {
									"value": {
										"value": "@div(sub(ticks(formatDateTime(utcNow(), 'yyyy-MM-dd HH:mm:ss')), ticks(variables('v_runstart_time'))), 10000000)",
										"type": "Expression"
									},
									"type": "Decimal"
								},
								"p_indents": {
									"value": "1",
									"type": "Int32"
								},
								"p_log_grade": {
									"value": "成功",
									"type": "String"
								},
								"p_log_message": {
									"value": {
										"value": "@concat('抽取 tds_',variables('v_table_name'),'到ODS成功')",
										"type": "Expression"
									},
									"type": "String"
								},
								"p_task_proc_name": {
									"value": {
										"value": "@concat(pipeline().Pipeline,':',pipeline().RunId)",
										"type": "Expression"
									},
									"type": "String"
								}
							}
						},
						"linkedServiceName": {
							"referenceName": "[parameters('AzureSqlDatabase1')]",
							"type": "LinkedServiceReference"
						}
					},
					{
						"name": "sp_write_failure_log",
						"type": "SqlServerStoredProcedure",
						"dependsOn": [
							{
								"activity": "df_tds_ods",
								"dependencyConditions": [
									"Failed"
								]
							}
						],
						"policy": {
							"timeout": "0.12:00:00",
							"retry": 0,
							"retryIntervalInSeconds": 30,
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"storedProcedureName": "[[dbo].[common_write_log]",
							"storedProcedureParameters": {
								"p_execute_sec": {
									"value": {
										"value": "@div(sub(ticks(formatDateTime(utcNow(), 'yyyy-MM-dd HH:mm:ss')), ticks(variables('v_runstart_time'))), 10000000)",
										"type": "Expression"
									},
									"type": "Decimal"
								},
								"p_indents": {
									"value": "0",
									"type": "Int32"
								},
								"p_log_grade": {
									"value": "失败",
									"type": "String"
								},
								"p_log_message": {
									"value": {
										"value": "@concat('抽取 tds_',variables('v_table_name'),'到ODS失败')",
										"type": "Expression"
									},
									"type": "String"
								},
								"p_task_proc_name": {
									"value": {
										"value": "@concat(pipeline().Pipeline,':',pipeline().RunId)",
										"type": "Expression"
									},
									"type": "String"
								}
							}
						},
						"linkedServiceName": {
							"referenceName": "[parameters('AzureSqlDatabase1')]",
							"type": "LinkedServiceReference"
						}
					},
					{
						"name": "sc_update_flag",
						"type": "Script",
						"dependsOn": [
							{
								"activity": "df_tds_ods",
								"dependencyConditions": [
									"Succeeded"
								]
							}
						],
						"policy": {
							"timeout": "0.12:00:00",
							"retry": 0,
							"retryIntervalInSeconds": 30,
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"linkedServiceName": {
							"referenceName": "[parameters('AzureSqlDatabase1')]",
							"type": "LinkedServiceReference"
						},
						"typeProperties": {
							"scripts": [
								{
									"parameters": [
										{
											"name": "p_source_name",
											"type": "String",
											"value": {
												"value": "@variables('v_table_name')",
												"type": "Expression"
											},
											"direction": "Input"
										}
									],
									"type": "NonQuery",
									"text": "update current_info_ods\nset hss_succeed_flag = 'Y'\nwhere source_table_name =@p_source_name"
								}
							],
							"scriptBlockExecutionTimeout": "02:00:00"
						}
					},
					{
						"name": "df_tds_ods",
						"type": "ExecuteDataFlow",
						"dependsOn": [
							{
								"activity": "sp_write_begin_log",
								"dependencyConditions": [
									"Succeeded"
								]
							}
						],
						"policy": {
							"timeout": "0.12:00:00",
							"retry": 0,
							"retryIntervalInSeconds": 30,
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"dataflow": {
								"referenceName": "dataflow_tds_ods",
								"type": "DataFlowReference",
								"parameters": {
									"p_start_time": {
										"value": "'@{variables('v_runstart_time')}'",
										"type": "Expression"
									},
									"p_tds_talbe": {
										"value": "'@{concat('tds_',variables('v_table_name'))}'",
										"type": "Expression"
									},
									"p_ods_table": {
										"value": "'@{concat('ods_',variables('v_table_name'))}'",
										"type": "Expression"
									}
								}
							},
							"compute": {
								"coreCount": 8,
								"computeType": "General"
							},
							"traceLevel": "Fine"
						}
					}
				],
				"variables": {
					"v_begin_time": {
						"type": "String"
					},
					"v_end_time": {
						"type": "String"
					},
					"v_table_name": {
						"type": "String"
					},
					"v_inc_col": {
						"type": "String"
					},
					"v_runstart_time": {
						"type": "String"
					}
				},
				"annotations": []
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/dataflows/dataflow_tds_ods')]"
			]
		},
		{
			"name": "[concat(parameters('factoryName'), '/dataflow_tds_ods')]",
			"type": "Microsoft.DataFactory/factories/dataflows",
			"apiVersion": "2018-06-01",
			"properties": {
				"description": "第三种方法用做exist，union最优，\n采用做模版",
				"type": "MappingDataFlow",
				"typeProperties": {
					"sources": [
						{
							"dataset": {
								"referenceName": "tds_file",
								"type": "DatasetReference"
							},
							"name": "sourcetds"
						},
						{
							"dataset": {
								"referenceName": "odsfile",
								"type": "DatasetReference"
							},
							"name": "sourceods"
						}
					],
					"sinks": [
						{
							"dataset": {
								"referenceName": "odsfile",
								"type": "DatasetReference"
							},
							"name": "sink1"
						}
					],
					"transformations": [
						{
							"name": "exists1"
						},
						{
							"name": "union1"
						}
					],
					"scriptLines": [
						"parameters{",
						"     p_start_time as string ('2026-01-24 06:20:05'),",
						"     p_tds_talbe as string ('tds_order_info'),",
						"     p_ods_table as string ('ods_order_info')",
						"}",
						"source(output(",
						"          id as long,",
						"          consignee as string,",
						"          consignee_tel as string,",
						"          total_amount as decimal(38,18),",
						"          order_status as string,",
						"          user_id as long,",
						"          payment_way as string,",
						"          delivery_address as string,",
						"          order_comment as string,",
						"          out_trade_no as string,",
						"          trade_body as string,",
						"          create_time as timestamp,",
						"          operate_time as timestamp,",
						"          expire_time as timestamp,",
						"          process_status as string,",
						"          tracking_no as string,",
						"          parent_order_id as long,",
						"          img_url as string,",
						"          province_id as integer,",
						"          activity_reduce_amount as decimal(38,18),",
						"          coupon_reduce_amount as decimal(38,18),",
						"          original_total_amount as decimal(38,18),",
						"          feight_fee as decimal(38,18),",
						"          feight_fee_reduce as decimal(38,18),",
						"          refundable_time as timestamp",
						"     ),",
						"     allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     ignoreNoFilesFound: false,",
						"     purgeFiles: true,",
						"     format: 'parquet',",
						"     wildcardPaths:[(concat( $p_tds_talbe, '/*.parquet'))]) ~> sourcetds",
						"source(output(",
						"          id as long,",
						"          consignee as string,",
						"          consignee_tel as string,",
						"          total_amount as decimal(38,18),",
						"          order_status as string,",
						"          user_id as long,",
						"          payment_way as string,",
						"          delivery_address as string,",
						"          order_comment as string,",
						"          out_trade_no as string,",
						"          trade_body as string,",
						"          create_time as timestamp,",
						"          operate_time as timestamp,",
						"          expire_time as timestamp,",
						"          process_status as string,",
						"          tracking_no as string,",
						"          parent_order_id as long,",
						"          img_url as string,",
						"          province_id as integer,",
						"          activity_reduce_amount as decimal(38,18),",
						"          coupon_reduce_amount as decimal(38,18),",
						"          original_total_amount as decimal(38,18),",
						"          feight_fee as decimal(38,18),",
						"          feight_fee_reduce as decimal(38,18),",
						"          refundable_time as timestamp",
						"     ),",
						"     allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     ignoreNoFilesFound: false,",
						"     purgeFiles: true,",
						"     modifiedBefore: (toTimestamp($p_start_time,'yyyy-MM-dd HH:mm:ss')),",
						"     format: 'parquet',",
						"     wildcardPaths:[(concat( $p_ods_table, '/*.parquet'))]) ~> sourceods",
						"sourceods, sourcetds exists(sourceods@id == sourcetds@id,",
						"     negate:true,",
						"     broadcast: 'auto')~> exists1",
						"exists1, sourcetds union(byName: true)~> union1",
						"union1 sink(allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     format: 'parquet',",
						"     filePattern:(concat( $p_ods_table, '/ ',substring($p_start_time,1,10),'.parquet')),",
						"     umask: 0022,",
						"     preCommands: [],",
						"     postCommands: [],",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true,",
						"     saveOrder: 1) ~> sink1"
					]
				}
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/datasets/tds_file')]",
				"[concat(variables('factoryId'), '/datasets/odsfile')]"
			]
		},
